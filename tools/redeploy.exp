#!/usr/bin/expect -f
log_user 1
set timeout 30

spawn telnet 10.0.10.129

expect "login:"
send "root\r"
expect -re "assword:"
send "AK2040jk\r"
expect "#"

send "killall mqtt_feeder 2>/dev/null; sleep 1; echo K\r"
expect "K"
expect "#"

send "wget -q http://<YOUR_IP>:8888/mqtt_feeder_v11 -O /tmp/mqtt_feeder && chmod +x /tmp/mqtt_feeder && echo OK\r"
expect {
    -timeout 30 "OK" {}
    timeout { puts "DL FAILED"; exit 1 }
}
expect "#"

send "/tmp/mqtt_feeder >> /tmp/mqtt_feeder_v11.log 2>&1 &\r"
expect "#"

send "sleep 5 && cat /tmp/mqtt_feeder_v11.log 2>&1\r"
expect {
    -timeout 15 "session established" {}
    -timeout 15 "#" {}
    timeout {}
}
expect "#"

puts "\n=== mqtt_feeder v1.1 running with portion support ==="
puts "=== Set slider to 2-3 portions in HA, then press Feed ==="

send "exit\r"
expect eof
